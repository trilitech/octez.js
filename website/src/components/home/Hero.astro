---
import { DEFAULT_VERSION } from "../../pages/api/search/[version].json.ts";

// Normalize base URL to always have trailing slash for path joining
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<section class="bg-background-primary py-20 px-8">
  <div class="md:max-w-1/2 mx-auto text-left">
    <h1 class="text-4xl font-bold text-text-primary mb-6">
      Developing on Tezos can be delicious!
    </h1>
    <p class="text-lg text-text-secondary mb-8">
      Use our popular octez.js TypeScript library to develop your Tezos
      blockchain apps faster and easier
    </p>
    <a
      href={`${base}docs/${DEFAULT_VERSION}/quick_start`}
      class="bg-accent text-white hover:bg-accent-dark transition-colors duration-150 px-5 py-2.5 rounded-full text-lg"
      >Get Started</a
    >
  </div>
</section>
