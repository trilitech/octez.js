{
  "name": "@tezos-x/octez.js-dapp-wallet",
  "maintainers": [
    "Nomadic Labs <contact@nomadic-labs.com>"
  ],
  "version": "1.0.0",
  "description": "TZIP-10 Beacon wallet integration for octez.js dapps built on the Beacon SDK DAppClient.",
  "keywords": [
    "octez.js",
    "tezos",
    "typescript",
    "blockchain",
    "wallet",
    "beacon"
  ],
  "main": "dist/octez.js-dapp-wallet.umd.js",
  "module": "dist/octez.js-dapp-wallet.es6.js",
  "typings": "dist/types/octez.js-dapp-wallet.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/octez.js-dapp-wallet.d.ts",
      "import": "./dist/octez.js-dapp-wallet.es6.js",
      "require": "./dist/octez.js-dapp-wallet.umd.js"
    },
    "./types": {
      "types": "./dist/types/beacon-types.d.ts",
      "import": "./dist/beacon-types.es6.js",
      "require": "./dist/beacon-types.umd.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "author": "ECAD Labs Inc <info@ecadlabs.com>",
  "contributors": [
    "Roxane Letourneau <roxane@ecadlabs.com>",
    "Davis Sawali <davis.sawali@ecadlabs.com>",
    "Jev Bj\u00f6rsell (jevonearth)",
    "Simon Boissonneault-Robert <simon@ecadlabs.com>"
  ],
  "homepage": "https://octez.js.io/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trilitech/octez.js.git"
  },
  "bugs": {
    "url": "https://github.com/trilitech/octez.js/issues"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run --config ./vitest.config.ts",
    "test:watch": "vitest --config ./vitest.config.ts",
    "test:prod": "npm run lint && npm run test",
    "lint": "eslint --ext .js,.ts .",
    "precommit": "lint-staged",
    "prebuild": "rimraf dist",
    "version-stamp": "node ../octez.js/version-stamping.js",
    "build": "tsc --project ./tsconfig.prod.json --module commonjs && rollup -c rollup.config.ts --bundleConfigAsCjs",
    "start": "rollup -c rollup.config.ts --bundleConfigAsCjs -w",
    "build-webpack": "webpack --progress --color"
  },
  "lint-staged": {
    "{src,test}/**/*.ts": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@tezos-x/octez.connect-dapp": "4.8.4",
    "@tezos-x/octez.connect-types": "4.8.4",
    "@tezos-x/octez.js-core": "^1.0.0",
    "@tezos-x/octez.js": "^1.0.0",
    "@tezos-x/octez.js-utils": "^1.0.0",
    "typedarray-to-buffer": "^4.0.0",
    "util": "^0.12.5"
  },
  "devDependencies": {
    "@tezos-x/octez.connect-transport-postmessage": "4.8.4",
    "@tezos-x/octez.connect-ui": "4.8.4",
    "@types/bluebird": "^3.5.42",
    "@types/chrome": "0.1.40",
    "@types/node": "^22.20.0",
    "@types/ws": "^8.5.12",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "colors": "^1.4.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.0",
    "fake-indexeddb": "^6.2.5",
    "lint-staged": "^15.2.7",
    "lodash.camelcase": "^4.3.0",
    "prettier": "^3.8.4",
    "prompt": "^1.3.0",
    "replace-in-file": "^8.1.0",
    "rimraf": "^6.0.1",
    "rollup": "^4.62.2",
    "rollup-plugin-json": "^4.0.0",
    "rollup-plugin-polyfill-node": "^0.13.0",
    "rollup-plugin-typescript2": "^0.37.0",
    "shelljs": "^0.8.5",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "ts-toolbelt": "^9.6.0",
    "typescript": "^5.9.3",
    "webpack": "^5.107.2",
    "webpack-cli": "^5.1.4"
  },
  "gitHead": "551e35aeff7d6dcde1c72284238c0ed3c3aae77e"
}
