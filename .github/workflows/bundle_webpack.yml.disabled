name: Bundle Webpack

on:
  pull_request:
    paths-ignore:
      - 'website/**'
  push:
    branches:
      - main

concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}-${{ github.ref != 'refs/heads/main' || github.run_number }}
  cancel-in-progress: ${{ startsWith(github.ref, 'refs/pull/') }}

permissions:
  contents: read

jobs:
  bundle-webpack:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v6
      - uses: actions/setup-node@v6
        with:
          node-version: 24
          cache: npm
      - run: npm ci
      - run: npm run build
      - run: npm -w packages/octez.js-local-forging run build-webpack
      - uses: actions/upload-artifact@v7
        with:
          name: octez.js-local-forging-vanilla
          path: |
            packages/octez.js-local-forging/dist/octez_js_local_forging.js
            packages/octez.js-local-forging/dist/octez_js_local_forging.js.map

      - run: npm -w packages/octez.js-dapp-wallet run build-webpack
      - uses: actions/upload-artifact@v7
        with:
          name: octez.js-dapp-wallet-vanilla
          path: |
            packages/octez.js-dapp-wallet/dist/octez_js_beacon_wallet.js
            packages/octez.js-dapp-wallet/dist/octez_js_beacon_wallet.js.map
