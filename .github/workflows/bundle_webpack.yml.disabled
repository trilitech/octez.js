name: Bundle Webpack

on:
  pull_request:
  push:
    branches:
      - master

concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}-${{ github.ref != 'refs/heads/master' || github.run_number }}
  cancel-in-progress: ${{ startsWith(github.ref, 'refs/pull/') }}

jobs:
  bundle-webpack:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: lts/Iron
      - run: npm ci
      - run: npm run build
      - run: npm -w packages/octez.js-local-forging run build-webpack
      - uses: actions/upload-artifact@v4
        with:
          name: octez.js-local-forging-vanilla
          path: |
            packages/octez.js-local-forging/dist/octez_js_local_forging.js
            packages/octez.js-local-forging/dist/octez_js_local_forging.js.map

      - run: npm -w packages/octez.js-beacon-wallet run build-webpack
      - uses: actions/upload-artifact@v4
        with:
          name: octez.js-beacon-wallet-vanilla
          path: |
            packages/octez.js-beacon-wallet/dist/octez_js_beacon_wallet.js
            packages/octez.js-beacon-wallet/dist/octez_js_beacon_wallet.js.map
