{
  "name": "integration-tests",
  "scripts": {
    "test": "jest",
    "test:secret-key": "RUN_WITH_SECRET_KEY=true jest --runInBand",
    "test:tallinnnet": "TALLINNNET=true jest",
    "test:tallinnnet-secret-key": "RUN_TALLINNNET_WITH_SECRET_KEY=true jest --runInBand",
    "test:ghostnet": "GHOSTNET=true jest",
    "test:ghostnet-secret-key": "RUN_GHOSTNET_WITH_SECRET_KEY=true jest --runInBand",
    "test:shadownet": "SHADOWNET=true jest",
    "test:shadownet-secret-key": "RUN_SHADOWNET_WITH_SECRET_KEY=true jest --runInBand",
    "test:weeklynet-secret-key": "RUN_WEEKLYNET_WITH_SECRET_KEY=true jest --runInBand",
    "test:tezlinkshadownet-secret-key": "RUN_TEZLINKSHADOWNET_WITH_SECRET_KEY=true jest --runInBand",
    "originate-known-contracts": "node -r ts-node/register originate-known-contracts.ts",
    "originate-known-contracts-and-run-test": "node -r ts-node/register originate-known-contracts.ts && jest"
  },
  "version": "1.0.0",
  "dependencies": {
    "@ledgerhq/devices": "^8.8.0",
    "@ledgerhq/hw-transport": "^6.31.15",
    "@ledgerhq/hw-transport-node-hid": "6.29.16",
    "@ledgerhq/hw-transport-node-hid-noevents": "6.30.16",
    "@tezos-x/octez.js-contracts-library": "*",
    "@tezos-x/octez.js-core": "*",
    "@tezos-x/octez.js-http-utils": "*",
    "@tezos-x/octez.js-local-forging": "*",
    "@tezos-x/octez.js-michel-codec": "*",
    "@tezos-x/octez.js-michelson-encoder": "*",
    "@tezos-x/octez.js-remote-signer": "*",
    "@tezos-x/octez.js-rpc": "*",
    "@tezos-x/octez.js-sapling": "*",
    "@tezos-x/octez.js-signer": "*",
    "@tezos-x/octez.js": "*",
    "@tezos-x/octez.js-tzip12": "*",
    "@tezos-x/octez.js-tzip16": "*",
    "@tezos-x/octez.js-utils": "*",
    "bignumber.js": "^9.1.2",
    "bip39": "3.1.0",
    "blakejs": "^1.2.1"
  },
  "private": true,
  "jest": {
    "transform": {
      ".(ts|tsx)": "ts-jest"
    },
    "testEnvironment": "node",
    "testRegex": "(/__tests__/.*|\\.(test|spec))\\.(ts|tsx|js)$",
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/test/"
    ],
    "testPathIgnorePatterns": [
      "./ledger-signer.spec.ts",
      "./ledger-signer-failing-tests.spec.ts"
    ],
    "reporters": [
      "default",
      "jest-stare"
    ],
    "testResultsProcessor": "../node_modules/jest-stare"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "jest-config": "^29.7.0",
    "jest-retries": "^1.0.1",
    "jest-stare": "2.5.1",
    "lint-staged": "^15.2.7",
    "ts-jest": "^29.2.3",
    "ts-node": "^10.9.2",
    "typescript": "~5.5.4"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-conventional-changelog"
    }
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  }
}
